# Public (exposed to the browser)
NEXT_PUBLIC_SITE_URL=https://inqvexa.com

# Server only — set in AWS Amplify → Environment variables. Never commit real values.
CONTACT_TO_EMAIL=karthik.bm@inqvexa.com
